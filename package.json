{
	"name": "torrust-website",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "tsx scripts/generateMetadata.ts && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint --ignore-pattern .svelte-kit/output .",
		"postbuild": "svelte-sitemap --domain https://torrust.com/",
		"update-contributors": "tsx scripts/updateContributors.ts",
		"pre-commit": "bash scripts/pre-commit.sh",
		"prepare": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^10.0.1",
		"@melt-ui/pp": "^0.3.2",
		"@melt-ui/svelte": "^0.86.6",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.53.1",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@types/dateformat": "^5.0.3",
		"@types/node": "^22.19.11",
		"@types/prismjs": "^1.26.6",
		"@typescript-eslint/eslint-plugin": "^8.56.1",
		"@typescript-eslint/parser": "^8.56.1",
		"autoprefixer": "^10.4.24",
		"eslint": "^10.0.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-svelte": "^3.15.0",
		"globals": "^17.3.0",
		"mdsvex": "^0.12.6",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.0",
		"prettier-plugin-tailwindcss": "^0.6.10",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-slug": "^6.0.0",
		"sass": "^1.97.3",
		"svelte": "^5.53.3",
		"svelte-check": "^4.4.3",
		"svelte-eslint-parser": "^1.5.1",
		"svelte-sitemap": "^2.7.1",
		"tailwindcss": "^3.4.19",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1",
		"vite": "^6.4.1",
		"vite-plugin-imagemin": "^0.6.1"
	},
	"dependencies": {
		"@fontsource-variable/roboto-mono": "^5.2.8",
		"@fontsource-variable/roboto-slab": "^5.2.8",
		"@iconify/svelte": "^5.2.1",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"dateformat": "^5.0.3",
		"flexsearch": "^0.8.212",
		"highlight.js": "^11.11.1",
		"reading-time": "^1.5.0",
		"rehype-pretty-code": "^0.14.1",
		"striptags": "^3.2.0"
	}
}
