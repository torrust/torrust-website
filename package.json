{
	"name": "torrust-website",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=26.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "tsx scripts/generateMetadata.ts && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint --ignore-pattern .svelte-kit/output .",
		"update-contributors": "tsx scripts/updateContributors.ts",
		"pre-commit": "bash scripts/pre-commit.sh",
		"prepare": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.5",
		"@eslint/js": "^10.0.1",
		"@melt-ui/pp": "^0.3.2",
		"@melt-ui/svelte": "^0.86.6",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.67.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/dateformat": "^5.0.3",
		"@types/node": "^26.0.0",
		"@types/prismjs": "^1.26.6",
		"@typescript-eslint/eslint-plugin": "^8.62.0",
		"@typescript-eslint/parser": "^8.62.0",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.7.0",
		"mdsvex": "^0.12.7",
		"prettier": "^3.9.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-slug": "^6.0.0",
		"sass": "^1.99.0",
		"svelte": "^5.55.4",
		"svelte-check": "^4.4.6",
		"svelte-eslint-parser": "^1.6.0",
		"svelte-sitemap": "^4.0.3",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.62.0",
		"vite": "^8.0.8",
		"vite-plugin-imagemin": "^0.6.1"
	},
	"dependencies": {
		"@fontsource-variable/roboto-mono": "^5.2.9",
		"@fontsource-variable/roboto-slab": "^5.2.8",
		"@iconify/svelte": "^5.2.1",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.2.2",
		"dateformat": "^5.0.3",
		"flexsearch": "^0.8.212",
		"highlight.js": "^11.11.1",
		"reading-time": "^1.5.0",
		"rehype-pretty-code": "^0.14.3",
		"striptags": "^3.2.0"
	}
}
